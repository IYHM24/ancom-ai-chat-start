<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bb72eb64-0dc2-452c-92d3-062400a40924</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.82.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.82.0-alpha" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.19.0" />
  </ItemGroup>

	<!-- Ejecuta el script de ngrok escapando rutas con espacios y caracteres especiales -->
	<Target Name="LaunchNgrokPS" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; '$(MSBuildProjectDirectory)\start-ngrok.ps1'&quot;" ContinueOnError="true" />
	</Target>
	
</Project>
